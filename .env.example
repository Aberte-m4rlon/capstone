# ─────────────────────────────────────────────────────────────────────────────
# AlpasFarm — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required — public, safe to be VITE_) ───────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase Server-Side (used in serverless /api endpoints) ──────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Supabase Service Role (used in AdminPage.tsx client-side admin panel) ─────
VITE_SUPABASE_SERVICE_KEY=your-service-role-key

# ── Firebase Phone Authentication (10,000 Free Real SMS / month) ─────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ── AI Mode (Google Gemini & Local/Ollama) ────────────────────────────────────
VITE_AI_MODE=production
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:1.5b

# ── REAL SMS NOTIFICATION GATEWAYS (Server-Side) ──────────────────────────────
# 1. Twilio SMS Gateway (Standard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# 2. Semaphore Philippine SMS Gateway (Direct Philippine Mobile Networks)
# Optional fallback if Twilio is not configured or for direct PH delivery
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=ALPASFARM

# ── REAL EMAIL NOTIFICATION GATEWAYS (Server-Side) ───────────────────────────
# 1. Standard SMTP / Nodemailer (Gmail, Zoho, SendGrid, Hostinger, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-farm-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=notifications@alpasfarm.ph
MAIL_FROM_NAME="ALPASFARM"

# 2. Resend API Email Gateway (Modern Transactional Email)
# Optional fallback if SMTP is not configured
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin & Support Contact (Configurable for Help & Support Modal) ──────────
VITE_ADMIN_EMAIL=admin@your-farm.ph
VITE_ADMIN_PHONE=+639123456789
