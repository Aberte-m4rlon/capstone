# ─────────────────────────────────────────────────────────────────────────────
# AlpasFarm — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required — public, safe to be VITE_) ───────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase Service Role (used only in AdminPage.tsx client-side admin panel)
# Note: this is already in your codebase; keep it here for reference.
# In production prefer a proper server-side admin API instead.
VITE_SUPABASE_SERVICE_KEY=your-service-role-key

# ── MyAI Mode ─────────────────────────────────────────────────────────────────
# "local"      → browser calls Ollama at VITE_OLLAMA_URL directly
# "production" → browser calls /api/ai/chat (Vercel serverless → Groq)
# Default when not set: production
VITE_AI_MODE=local

# ── Local Ollama (only used when VITE_AI_MODE=local) ─────────────────────────
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:1.5b

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION SERVER-SIDE VARIABLES
# Set these in Vercel dashboard → Project → Settings → Environment Variables
# DO NOT add VITE_ prefix — these must never reach the browser
# ─────────────────────────────────────────────────────────────────────────────

# Groq API key — get free at https://console.groq.com
# Add this in Vercel dashboard only, NOT in .env for Git
GROQ_API_KEY=your-groq-api-key

# Groq model (default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# ── Twilio Real SMS Gateway (Authentication OTP) ──────────────────────────────
# Add in Vercel Dashboard → Project Settings → Environment Variables
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Or if using a Messaging Service SID:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Semaphore SMS Gateway (Optional Philippines Fallback) ─────────────────────
# SEMAPHORE_API_KEY=your-semaphore-api-key
# SEMAPHORE_SENDER_NAME=SEMAPHORE
